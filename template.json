  "services": {
    "Outline": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/outline.svg",
      "source": {
        "repo": "baranberkay96/outline-railway",
        "rootDirectory": "/services/outline"
      },
      "startCommand": null,
      "preDeployCommand": "node /opt/outline/railway/predeploy.mjs",
      "preDeployTimeoutSeconds": 1500,
      "healthcheckPath": "/_health",
      "healthcheckTimeout": 600,
      "restartPolicyType": "ALWAYS",
      "numReplicas": 1,
      "cronSchedule": null,
      "publicDomain": true,
      "targetPort": 3000,
      "tcpProxy": null,
      "volume": null,
      "variables": {
        "PORT": {
          "defaultValue": "3000",
          "description": "Port Outline listens on.",
          "required": false
        },
        "NODE_ENV": {
          "defaultValue": "production",
          "description": "Run Outline in production mode.",
          "required": false
        },
        "URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Public URL of Outline. Change it (and redeploy Dex) when you add a custom domain.",
          "required": false
        },
        "SERVICES": {
          "defaultValue": "web,websockets,collaboration",
          "description": "Outline services in this container; background jobs run in Outline Worker.",
          "required": false
        },
        "WEB_CONCURRENCY": {
          "defaultValue": "1",
          "description": "Web processes (the collaboration service needs 1 without REDIS_COLLABORATION_URL).",
          "required": false
        },
        "SECRET_KEY": {
          "defaultValue": "${{secret(64, \"abcdef0123456789\")}}",
          "description": "Encrypts sessions and secrets (32-byte hex). Never change it after the first start.",
          "required": false
        },
        "UTILS_SECRET": {
          "defaultValue": "${{secret(64, \"abcdef0123456789\")}}",
          "description": "Secret for Outline's internal utility endpoints.",
          "required": false
        },
        "DATABASE_URL": {
          "defaultValue": "postgres://${{Postgres.POSTGRES_USER}}:${{Postgres.POSTGRES_PASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.POSTGRES_DB}}",
          "description": "Postgres on the private network.",
          "required": false
        },
        "PGSSLMODE": {
          "defaultValue": "disable",
          "description": "Private network traffic needs no TLS (Railway's Postgres certificate is self-signed).",
          "required": false
        },
        "REDIS_URL": {
          "defaultValue": "${{Redis.REDIS_URL}}",
          "description": "Redis for queues, websockets and caching.",
          "required": false
        },
        "FILE_STORAGE": {
          "defaultValue": "s3",
          "description": "Store attachments, avatars and imports in the Railway Bucket.",
          "required": false
        },
        "AWS_S3_UPLOAD_BUCKET_URL": {
          "defaultValue": "${{Bucket.ENDPOINT}}",
          "description": "Bucket endpoint.",
          "required": false
        },
        "AWS_S3_UPLOAD_BUCKET_NAME": {
          "defaultValue": "${{Bucket.BUCKET}}",
          "description": "Bucket name.",
          "required": false
        },
        "AWS_ACCESS_KEY_ID": {
          "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
          "description": "Bucket access key.",
          "required": false
        },
        "AWS_SECRET_ACCESS_KEY": {
          "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
          "description": "Bucket secret key.",
          "required": false
        },
        "AWS_REGION": {
          "defaultValue": "${{Bucket.REGION}}",
          "description": "Bucket region.",
          "required": false
        },
        "AWS_S3_FORCE_PATH_STYLE": {
          "defaultValue": "false",
          "description": "Railway Buckets use virtual-hosted-style URLs.",
          "required": false
        },
        "AWS_S3_UPLOAD_METHOD": {
          "defaultValue": "put",
          "description": "Browsers upload with presigned PUT requests.",
          "required": false
        },
        "FILE_STORAGE_UPLOAD_MAX_SIZE": {
          "defaultValue": "262144000",
          "description": "Largest attachment in bytes (250 MB).",
          "required": false
        },
        "BUCKET_CORS_ENABLED": {
          "defaultValue": "true",
          "description": "Pre-deploy sets the Bucket CORS rule that browser uploads need (origin: URL).",
          "required": false
        },
        "OUTLINE_ADMIN_EMAIL": {
          "defaultValue": "admin@${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "E-mail of the first admin and their login name. Put your own address here before the first deploy.",
          "required": false
        },
        "OUTLINE_ADMIN_PASSWORD": {
          "defaultValue": "${{secret(24, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\")}}",
          "description": "Admin password for the login page (12+ characters). Change it here and redeploy Dex.",
          "required": false
        },
        "OUTLINE_ADMIN_NAME": {
          "defaultValue": "Admin",
          "description": "Display name of the first admin.",
          "required": false
        },
        "OUTLINE_WORKSPACE_NAME": {
          "defaultValue": "Outline",
          "description": "Name of the workspace created on the first deploy.",
          "required": false
        },
        "OIDC_CLIENT_ID": {
          "defaultValue": "${{Dex.OIDC_CLIENT_ID}}",
          "description": "OAuth client id shared with Dex.",
          "required": false
        },
        "OIDC_CLIENT_SECRET": {
          "defaultValue": "${{Dex.OIDC_CLIENT_SECRET}}",
          "description": "OAuth client secret shared with Dex.",
          "required": false
        },
        "OIDC_AUTH_URI": {
          "defaultValue": "${{Dex.DEX_ISSUER}}/auth",
          "description": "Dex login page (public).",
          "required": false
        },
        "OIDC_TOKEN_URI": {
          "defaultValue": "http://${{Dex.RAILWAY_PRIVATE_DOMAIN}}:${{Dex.PORT}}/token",
          "description": "Dex token endpoint (private network).",
          "required": false
        },
        "OIDC_USERINFO_URI": {
          "defaultValue": "http://${{Dex.RAILWAY_PRIVATE_DOMAIN}}:${{Dex.PORT}}/userinfo",
          "description": "Dex userinfo endpoint (private network).",
          "required": false
        },
        "OIDC_DISPLAY_NAME": {
          "defaultValue": "Email and password",
          "description": "Label of the sign-in button.",
          "required": false
        },
        "OIDC_SCOPES": {
          "defaultValue": "openid profile email",
          "description": "Scopes requested from Dex.",
          "required": false
        },
        "DEFAULT_LANGUAGE": {
          "defaultValue": "en_US",
          "description": "Default interface language (e.g. de_DE, fr_FR, tr_TR).",
          "required": false
        },
        "FORCE_HTTPS": {
          "defaultValue": "true",
          "description": "Redirect plain HTTP to HTTPS (Railway terminates TLS).",
          "required": false
        },
        "ENABLE_UPDATES": {
          "defaultValue": "false",
          "description": "true: send anonymous usage statistics to Outline and check for updates.",
          "required": false
        },
        "RATE_LIMITER_ENABLED": {
          "defaultValue": "true",
          "description": "Per-IP API rate limiting.",
          "required": false
        },
        "SMTP_HOST": {
          "defaultValue": "",
          "description": "Optional SMTP host for notification e-mails and e-mail sign-in (Railway allows SMTP on Pro).",
          "required": false
        },
        "SMTP_PORT": {
          "defaultValue": "",
          "description": "Optional SMTP port.",
          "required": false
        },
        "SMTP_USERNAME": {
          "defaultValue": "",
          "description": "Optional SMTP user name.",
          "required": false
        },
        "SMTP_PASSWORD": {
          "defaultValue": "",
          "description": "Optional SMTP password.",
          "required": false
        },
        "SMTP_FROM_EMAIL": {
          "defaultValue": "",
          "description": "Optional sender address for e-mails.",
          "required": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "30",
          "description": "Grace period for open requests on redeploy.",
          "required": false
        }
      }
    },
